# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-value
PORT=8000

# Keep sqlite until scripts/import_supabase.py and staging checks succeed.
DATABASE_BACKEND=sqlite
DATABASE_SCHEMA=talentsouk
# Server-only PostgreSQL URI from Supabase Connect > Session pooler.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres

# Docker Compose sets this. For a direct host install, omit it to use the project root.
# STORAGE_ROOT=/var/lib/TalentSouk
SESSION_COOKIE_SECURE=1

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TalentSouk
SMTP_USE_TLS=true

# Optional free-tier AI providers. Create keys in Google AI Studio and/or Groq Console.
# Keep these server-side; never paste them into frontend JavaScript.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT_SECONDS=30

# Feature routing: NVIDIA Kimi for interviews, xAI Grok for matching, Gemini for writing.
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MATCHING_MODEL=grok-4.7
NVIDIA_INTERVIEW_MODEL=moonshotai/kimi-k3
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# Opportunity Radar (Jooble key must be issued for Morocco)
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Professional portraits: requires Gemini image-model access and sufficient quota.
GEMINI_PORTRAIT_MODEL=gemini-nano-banana-2.1

# Free Render hosting: private durable files in Supabase Storage.
# UPLOAD_STORAGE=supabase
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_STORAGE_BUCKET=talentsouk-private
# SUPABASE_STORAGE_KEY=server-only-service-role-key
# Free Render blocks SMTP. Use an approved Brevo sender via HTTPS instead.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=

# GitHub OAuth callback: https://YOUR-DOMAIN/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
